{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/SurveyManagementLambda:*"
    },
    {
      "Sid": "ReadOwnSecretOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${SurveyManagementSecretArn}"
    },
    {
      "Sid": "PublishSurveyLifecycleEventsOnly",
      "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:${Region}:${AccountId}:event-bus/course-feedback-events",
      "Condition": {
        "StringEquals": {
          "events:source": "course-feedback.survey-management",
          "events:detail-type": ["SurveyPublished", "SurveyClosed"]
        }
      }
    }
  ]
}
